rules_version = '2';

// Every user signs in anonymously, so request.auth.uid is the id the app uses for a person.
// An admin is a user with a document at admins/{uid}, created by hand in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function ownsCampsite(campsiteId) {
      return get(/databases/$(database)/documents/campsites/$(campsiteId)).data.ownerId == me();
    }

    // US 03.11.01: the app only checks whether its own admin document exists
    match /admins/{userId} {
      allow get: if signedIn() && userId == me();
      allow list, write: if false;
    }

    // US 02.01.x owner, US 01.01.x search, US 03.01.01 and 03.03.01 admin
    match /campsites/{campsiteId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if (signedIn() && resource.data.ownerId == me()
                          && request.resource.data.ownerId == me())
                    || isAdmin();
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }

    // US 02.11.01: one document per campsite, written by its owner
    match /campsiteRules/{campsiteId} {
      allow read: if signedIn();
      allow write: if signedIn() && ownsCampsite(campsiteId)
                   && request.resource.data.ownerId == me();
    }

    match /lotteries/{lotteryId} {
      // Entrant joins or leaves (US 01.01.06, 01.02.01, 01.02.02): only their own id changes
      function joining() {
        let before = resource.data.waitlist.toSet();
        let after = request.resource.data.waitlist.toSet();
        return onlyChanges(['waitlist'])
          && resource.data.drawn == false
          && after.difference(before) == [me()].toSet()
          && before.difference(after).size() == 0
          && (resource.data.get('waitlistCapacity', null) == null
              || request.resource.data.waitlist.size() <= resource.data.waitlistCapacity);
      }

      function leaving() {
        let before = resource.data.waitlist.toSet();
        let after = request.resource.data.waitlist.toSet();
        return onlyChanges(['waitlist'])
          && resource.data.drawn == false
          && before.difference(after) == [me()].toSet()
          && after.difference(before).size() == 0;
      }

      // US 02.05.01: any phone may run the draw once registration has been over for a day
      function drawing() {
        return onlyChanges(['waitlist', 'winners', 'losers', 'drawn'])
          && resource.data.drawn == false
          && request.resource.data.drawn == true
          && request.time.toMillis() >= resource.data.registrationEnd + 86400000;
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if signedIn() && (resource.data.ownerId == me() || joining() || leaving() || drawing());
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }

    match /reservations/{reservationId} {
      // Search (US 01.01.x) and booked dates (US 02.06.01) read other people's reservations
      allow read: if signedIn();
      // US 01.04.x: only a winner of the lottery can reserve
      allow create: if signedIn()
        && request.resource.data.entrantId == me()
        && request.resource.data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/lotteries/$(request.resource.data.lotteryId))
             .data.winners.hasAny([me()]);
      // US 01.06.01 entrant cancels, US 02.08.01 owner rejects
      allow update: if signedIn() && onlyChanges(['status']) && (
        (resource.data.entrantId == me() && request.resource.data.status == 'CANCELLED')
        || (resource.data.ownerId == me() && request.resource.data.status == 'REJECTED'));
      allow delete: if isAdmin();
    }

    // US 02.10.01 and 02.10.02 owner, US 03.08.01 admin log
    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.recipientId == me()
                                    || resource.data.senderId == me()
                                    || isAdmin());
      allow create: if signedIn() && request.resource.data.senderId == me();
      allow update: if signedIn() && resource.data.recipientId == me() && onlyChanges(['read']);
      allow delete: if isAdmin();
    }

    // US 02.12.01 owner, US 03.12.01 admin log
    match /messages/{messageId} {
      allow read: if signedIn() && (resource.data.senderId == me()
                                    || resource.data.recipientId == me()
                                    || isAdmin());
      allow create: if signedIn()
        && request.resource.data.senderId == me()
        && get(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
             .data.ownerId == me();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Profiles. Owners read notificationsEnabled before notifying (US 01.10.01).
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && userId == me();
      allow delete: if signedIn() && (userId == me() || isAdmin());
    }
  }
}
